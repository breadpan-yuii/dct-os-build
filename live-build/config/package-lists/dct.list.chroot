# Packages baked into the Dominican OS live image.
# This is a clean Ubuntu live-build root, not the prebuilt Ubuntu Cinnamon ISO,
# so explicitly install the official minimal Ubuntu Cinnamon desktop task.

ubuntucinnamon-desktop-minimal
# live-build's Ubuntu mode does not pull in the kernel through the desktop task.
linux-image-generic
# DCT packages are local .debs; scripts/build-iso.sh stages them and the
# 0100-dct-install-debs hook installs them after apt has installed this list.

# installer
calamares
calamares-settings-ubuntu-common

# classroom + resilience
epoptes-client
timeshift

# office
libreoffice-writer
libreoffice-calc
libreoffice-impress
libreoffice-gnome

# wine stack (licences for MS Office itself are NOT included — see docs/licensing.md)
wine
winetricks

# OnlyOffice: requires a third-party apt source. Uncomment only after you have
# placed the signing key in config/archives/onlyoffice.key.chroot
# onlyoffice-desktopeditors

# Philippine locale support
language-pack-en
