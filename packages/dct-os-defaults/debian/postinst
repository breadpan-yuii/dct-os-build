#!/bin/sh
set -e

# ---------------------------------------------------------------------------
# /etc/os-release is owned by base-files. If we just overwrite it, the next
# base-files upgrade silently reverts the machine to "Ubuntu 24.04.4 LTS".
#
# The diversion is registered by apply-branding.sh (its "update shield" step),
# not here. There must be exactly one implementation of it: registering a
# second diversion with a different name from this script would make the two
# disagree, and the second --add would fail because the file is already
# diverted. So this script only invokes the single implementation.
# ---------------------------------------------------------------------------
if [ -x /usr/share/dct-os/apply-branding.sh ]; then
    /usr/share/dct-os/apply-branding.sh || \
        echo "dct-os-defaults: branding script reported a problem (non-fatal)" >&2
else
    echo "dct-os-defaults: /usr/share/dct-os/apply-branding.sh missing" >&2
fi

if [ -d /usr/share/glib-2.0/schemas ]; then
    glib-compile-schemas /usr/share/glib-2.0/schemas || true
fi

exit 0
