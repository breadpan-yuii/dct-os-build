# Dominican OS — single source of truth for identity + colours.
# Every script and template reads these. Change a colour here, rebuild, done.

DCT_VERSION=1.0
DCT_CODENAME=tarlac
DCT_BASE=noble                 # Ubuntu 24.04 LTS codename — do not change casually
DCT_NAME="Dominican OS"
DCT_PRETTY_NAME="Dominican OS 1.0"
DCT_VENDOR="Dominican College of Tarlac"
DCT_HOME_URL="https://dct.edu.ph"
DCT_SUPPORT_URL="https://dct.edu.ph/helpdesk"

# --- palette (hex, no '#') -------------------------------------------------
# DCT is purple + gray. DCT_PURPLE is the accent already carried by the Yaru
# purple theme that ships in the Ubuntu Cinnamon base, so the GTK theme, icons,
# Cinnamon shell, greeter and our own artwork all agree without authoring a
# theme from scratch. Confirm the exact hex against the DCT brand sheet; if it
# differs, change it here and rebuild — every generated asset follows.
DCT_PURPLE=7764D8
DCT_PURPLE_DEEP=3B326C
DCT_PURPLE_LIGHT=C3B6F0
DCT_GRAY=2E2E2E
DCT_GRAY_DARK=232323
DCT_GRAY_MID=5A5A5A
DCT_GRAY_LIGHT=D6D6D6
DCT_WHITE=FFFFFF
DCT_TEXT_MUTED=C9C6D6

# --- typography (open fonts only — never ship proprietary faces) -----------
DCT_FONT="Inter"
DCT_FONT_MONO="JetBrains Mono"
