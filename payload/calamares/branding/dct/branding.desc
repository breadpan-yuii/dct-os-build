---
# Calamares branding for Dominican OS.
# Install to /usr/share/calamares/branding/dct/branding.desc
# referenced from /etc/calamares/settings.conf via:  branding: dct
#
# Deliberately no `slideshow:` key — a broken show.qml makes the installer
# crash on the branding page, which is the worst possible place to fail.
# Add a slideshow later, once you have images worth showing.

componentName: dct

strings:
    productName:         "@DCT_NAME@"
    shortProductName:    "@DCT_NAME@"
    version:             "@DCT_VERSION@"
    shortVersion:        "@DCT_VERSION@"
    versionedName:       "@DCT_PRETTY_NAME@ (@DCT_CODENAME@)"
    shortVersionedName:  "@DCT_PRETTY_NAME@"
    bootloaderEntryName: "@DCT_NAME@"
    productUrl:          "@DCT_HOME_URL@"
    supportUrl:          "@DCT_SUPPORT_URL@"
    releaseNotesUrl:     "@DCT_SUPPORT_URL@"
    knownIssuesUrl:      "@DCT_SUPPORT_URL@"

images:
    productLogo:    "logo.png"
    productIcon:    "logo.png"
    productWelcome: "welcome.png"

style:
    # Rendered from payload/branding/tokens.env by apply-branding.sh.
    sidebarBackground:      "@DCT_PURPLE_DEEP@"
    sidebarText:            "@DCT_WHITE@"
    sidebarTextSelect:      "@DCT_PURPLE_LIGHT@"
    sidebarTextHighlight:   "@DCT_PURPLE_LIGHT@"
    sidebarBackgroundCurrent: "@DCT_GRAY_DARK@"

    windowPlacement: center

    # Uncomment once logo.png exists and you have checked the layout on a
    # 1024x768 screen, which is what the lab monitors actually are.
    # sidebarBackgroundCurrent: "@DCT_PURPLE@"
