/* Dominican OS — Calamares stylesheet.
   Install to /etc/calamares/branding/dct/stylesheet.qss
   Colours are rendered from payload/branding/tokens.env by apply-branding.sh
   (the DCT_* tokens) — edit the tokens, not the hex.
   Qt stylesheets are limited; keep selectors defensive — an unknown widget
   is ignored, but a malformed rule kills the whole sheet. */

QWidget {
    font-family: "Inter", "DejaVu Sans", sans-serif;
    font-size: 10pt;
}

#mainApp {
    background-color: @DCT_PURPLE_DEEP@;
}

#sidebarApp {
    background-color: @DCT_GRAY_DARK@;
}

QLabel {
    color: @DCT_WHITE@;
}

QLabel#headerLabel {
    color: @DCT_PURPLE_LIGHT@;
    font-size: 14pt;
    font-weight: bold;
}

QLineEdit, QComboBox, QSpinBox, QPlainTextEdit {
    background-color: @DCT_WHITE@;
    color: @DCT_PURPLE_DEEP@;
    border: 1px solid @DCT_TEXT_MUTED@;
    border-radius: 4px;
    padding: 4px;
}

QPushButton {
    background-color: @DCT_PURPLE@;
    color: @DCT_WHITE@;
    border: none;
    border-radius: 4px;
    padding: 6px 18px;
}

QPushButton:hover {
    background-color: @DCT_PURPLE_DEEP@;
}

QPushButton:disabled {
    background-color: @DCT_GRAY_MID@;
    color: @DCT_TEXT_MUTED@;
}

QProgressBar {
    border: 1px solid @DCT_TEXT_MUTED@;
    border-radius: 4px;
    text-align: center;
    color: @DCT_WHITE@;
}

QProgressBar::chunk {
    background-color: @DCT_PURPLE_LIGHT@;
}
