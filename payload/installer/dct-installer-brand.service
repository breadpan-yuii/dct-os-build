[Unit]
Description=DCT OS artwork for the Ubuntu desktop installer
Documentation=file:///usr/share/dct-os/README.md
# The snap's own mount unit is named after its revision, so order against the
# target that collects those mounts instead of a revision-specific unit. This
# deliberately does not wait for snapd.service: seeding runs at every live boot
# and the desktop must not queue behind it.
After=snapd.mounts.target
RequiresMountsFor=/snap/ubuntu-desktop-bootstrap/current
Before=display-manager.service
ConditionPathExists=/snap/ubuntu-desktop-bootstrap/current/bin/data/flutter_assets/packages/ubuntu_provision/assets/whitelabel.yml

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/share/dct-os/dct-installer-brand

[Install]
WantedBy=multi-user.target
