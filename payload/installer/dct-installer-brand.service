[Unit]
Description=DCT OS artwork for the Ubuntu desktop installer
Documentation=file:///usr/share/dct-os/README.md
# snapd writes the installer's launcher when it links the snap, so wait for it
# before rewriting that launcher. The snap's own mount unit is named after its
# revision, so order against the target that collects those mounts instead.
After=snapd.service snapd.mounts.target
RequiresMountsFor=/snap/ubuntu-desktop-bootstrap/current
Before=display-manager.service
ConditionPathExists=/snap/ubuntu-desktop-bootstrap/current/bin/data/flutter_assets/packages/ubuntu_provision/assets/whitelabel.yml

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/share/dct-os/dct-installer-brand

[Install]
WantedBy=multi-user.target
